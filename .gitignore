# autoconf creates these ephemeral files
config.log
config.h
config.status
Makefile

# Object files
*.o

# Libraries
*.lib
*.a

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app

# Temporary and Backup
*~
*.bak

#output files
bin
ah.stderr
ah.stdout

# Game files
*.cfg
*.his
*.ord
*.tmp

# Committed test fixtures are exempt from the game-file ignores above
!tests/fixtures/*.ord
